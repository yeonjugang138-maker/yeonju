// =====================================================
// Arduino2 - ESP8266 - Server 연동용 (LED 테스트)
//
// ESP8266으로부터 시리얼로 급수 명령을 받아 LED를 켜고 끄며,
// 상태(WATERING/COMPLETED)를 taskId와 함께 ESP8266에 알려준다.
// (ESP8266이 STATE:taskId:상태 형식을 기대하므로 taskId 필수)
// -----------------------------------------------------
// 수신 형식: WATER:task_id:plant_id:amount_ml
// 송신 형식: STATE:task_id:상태
// =====================================================

#include <SoftwareSerial.h>

SoftwareSerial espSerial(2, 3);  // (RX, TX) - 아두이노 기준: D2=RX, D3=TX

const int LED_PIN = 8;
float MS_PER_ML = 125.0;   // 측정 후 수정 필요

unsigned long endTime = 0;
bool isOn = false;
String currentTaskId = "";   // 지금 처리 중인 작업의 task_id

void setup() {
  Serial.begin(9600);
  espSerial.begin(9600);
  pinMode(LED_PIN, OUTPUT);
}

void loop() {
  // -----------------------------------------------
  // ESP8266으로부터 새 메시지 확인
  // -----------------------------------------------
  if (espSerial.available()) {
    String cmd = espSerial.readStringUntil('\n');
    cmd.trim();

    // -----------------------------------------------
    // 급수 명령: WATER:task_id:plant_id:amount_ml
    // task_id는 STATE 응답에 다시 써야 하므로 추출해서 보관
    // -----------------------------------------------
    if (cmd.startsWith("WATER:")) {
      if (!isOn) {
        String rest = cmd.substring(6);              // "task_id:plant_id:amount_ml"

        int c1 = rest.indexOf(':');                  // task_id 끝 위치
        String taskId = rest.substring(0, c1);

        String afterTaskId = rest.substring(c1 + 1); // "plant_id:amount_ml"
        int c2 = afterTaskId.indexOf(':');            // plant_id 끝 위치

        float amount = afterTaskId.substring(c2 + 1).toFloat();

        currentTaskId = taskId;

        digitalWrite(LED_PIN, HIGH);
        isOn = true;
        endTime = millis() + (unsigned long)(amount * MS_PER_ML);

        // taskId를 포함해서 ESP8266에 상태 전달 (서버로 전달되려면 필수)
        espSerial.print("STATE:");
        espSerial.print(taskId);
        espSerial.println(":WATERING");

        Serial.print("STATE:");
        Serial.print(taskId);
        Serial.println(":WATERING");
      }
    }
    // -----------------------------------------------
    // '#'으로 시작하는 ESP8266 상태 로그 (WiFi 연결 등)
    // -----------------------------------------------
    else if (cmd.startsWith("#")) {
      Serial.println(cmd);
    }
    // 그 외(WAIT 등)는 무시
  }

  // -----------------------------------------------
  // 목표 시간 도달 시 급수 종료
  // -----------------------------------------------
  if (isOn && millis() >= endTime) {
    digitalWrite(LED_PIN, LOW);
    isOn = false;

    // taskId를 포함해서 완료 보고 
    espSerial.print("STATE:");
    espSerial.print(currentTaskId);
    espSerial.println(":COMPLETED");

    Serial.print("STATE:");
    Serial.print(currentTaskId);
    Serial.println(":COMPLETED");
  }
}
