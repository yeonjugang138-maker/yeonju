CREATE DATABASE IF NOT EXISTS rosdb;
USE rosdb;

CREATE TABLE IF NOT EXISTS turtlepos (
  id     INT AUTO_INCREMENT PRIMARY KEY,
  x      DECIMAL(8, 5) NOT NULL,
  y      DECIMAL(8, 5) NOT NULL,
  theta  DECIMAL(8, 5) NOT NULL,
  `time` DATETIME(6)   NOT NULL
);

# VM(Ubuntu)의 ROS 노드가 Windows MySQL에 접속할 수 있도록 외부 접속용 계정 생성
# '%'는 어느 컴퓨터(IP)에서든 접속을 허용한다는 뜻 (root는 기본적으로 localhost만 허용)
# rosuser 계정에 rosdb 스키마의 모든 권한을 주고, FLUSH PRIVILEGES로 권한 변경을 바로 적용

CREATE USER IF NOT EXISTS 'rosuser'@'%' IDENTIFIED BY 'ros1234';
GRANT ALL PRIVILEGES ON rosdb.* TO 'rosuser'@'%';
FLUSH PRIVILEGES;

/*
[Windows에서 진행한 설정]

1. Windows IP 확인 (cmd)
   ipconfig
   -> IPv4 주소 확인: 192.168.0.141
   -> turtle_gui.py의 DB_CONFIG['host']에 이 주소를 입력

2. MySQL 포트(3306) 방화벽 열기 (PowerShell 관리자 권한)
   New-NetFirewallRule -DisplayName "MySQL 3306" -Direction Inbound -Protocol TCP -LocalPort 3306 -Action Allow

   cmd(관리자 권한)에서 할 경우:
   netsh advfirewall firewall add rule name="MySQL 3306" dir=in action=allow protocol=TCP localport=3306

[VM(Ubuntu)에서 연결 확인]

3. Windows MySQL까지 접속되는지 테스트
   nc -zv 192.168.0.141 3306
   -> "succeeded"가 나오면 연결 성공
*/
